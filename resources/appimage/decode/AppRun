#!/bin/bash
# AppRun — entry point with desktop integration.
# On first run, installs .desktop file and icon to ~/.local/share so
# GNOME/KDE/Cinnamon/Mint taskbars show the correct icon and allow pinning.

# Always derive APPDIR from $0 — when mounted, $0 is inside the mount
# point (e.g. /tmp/.mount_decodeXXXX/AppRun), so its dirname is the
# correct APPDIR. APPIMAGE is the *file path* of the AppImage, which
# is only useful for the .desktop Exec= line, not for finding bundled
# binaries.
self="$(readlink -f -- "$0")"
export APPDIR="${self%/*}"

# X11 window instance name; the class comes from qt_identity.apply_app_identity.
# Both end up as "vhs-decode" so the window matches vhs-decode.desktop.
export RESOURCE_NAME="vhs-decode"

# Desktop integration — runs once per AppImage path.
# Use APPIMAGE (the file path) for the marker and .desktop Exec= so
# the taskbar launches the AppImage file, not the mount point.
APPIMAGE_REF="${APPIMAGE:-${APPDIR}}"
# Integration version: bump to force regenerating the .desktop file.
INTEGRATION_VERSION="v2-wmclass"
MARKER="${HOME}/.local/share/applications/.vhs-decode-$(echo "${APPIMAGE_REF}|${INTEGRATION_VERSION}" | md5sum | cut -c1-8)"
if [ ! -f "${MARKER}" ]; then
    APPS_DIR="${HOME}/.local/share/applications"
    ICONS_DIR="${HOME}/.local/share/icons/hicolor/256x256/apps"
    mkdir -p "${APPS_DIR}" "${ICONS_DIR}" 2>/dev/null || true
    # Install icon
    [ -f "${APPDIR}/vhs-decode.png" ] && cp "${APPDIR}/vhs-decode.png" "${ICONS_DIR}/vhs-decode.png" 2>/dev/null || true
    # Generate .desktop file with absolute AppImage path in Exec
    cat > "${APPS_DIR}/vhs-decode.desktop" << EOF
[Desktop Entry]
Name=vhs-decode
Comment=Software defined VHS/LaserDisc/CVBS decoder
Exec=${APPIMAGE_REF} %f
Terminal=false
Icon=vhs-decode
Type=Application
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=vhs;laserdisc;ld;cvbs;rf;decode;video;tape;
TryExec=${APPIMAGE_REF}
StartupWMClass=vhs-decode
EOF
    update-desktop-database "${APPS_DIR}" 2>/dev/null || true
    gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" 2>/dev/null || true
    echo "${APPIMAGE_REF}" > "${MARKER}" 2>/dev/null || true
fi

# Launch the actual decode binary (APPDIR is the mount point, not the file)
exec "${APPDIR}/usr/bin/python3.12" -u "${APPDIR}/opt/python3.12/bin/decode.py" "$@"
